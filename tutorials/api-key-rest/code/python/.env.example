# #region config
# Configure the scripts: copy this file to .env and fill it in
PORTAL="https://www.arcgis.com/sharing/rest" # @var portalUrl
# Owner of the API key item
ITEM_OWNER="YOUR_USERNAME" # @var username
# App credentials of a service user, with that user's privileges (not the API key item's)
APP_CLIENT_ID="YOUR_APP_CLIENT_ID" # @var appClientId
APP_CLIENT_SECRET="YOUR_APP_CLIENT_SECRET" # @var appClientSecret
# #endregion config
